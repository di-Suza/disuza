NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017/devloopfeed
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
JWT_ACCESS_SECRET=devloopfeed_access_secret_change_me_32_chars
JWT_REFRESH_SECRET=devloopfeed_refresh_secret_change_me_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_MAX_AGE_MS=604800000
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
RESEND_API_KEY=
SENDER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_POST_IMAGE_MAX_COUNT=5
