NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017/disuza
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SOCKET_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SOCKET_PING_TIMEOUT_MS=60000
SOCKET_PING_INTERVAL_MS=25000
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
JOB_WORKERS_ENABLED=false
LOG_LEVEL=info
PRIVATE_JWT_KEY_BS64=
PUBLIC_JWT_KEY_BS64=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_MAX_AGE_MS=604800000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
RESEND_API_KEY=
SENDER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_MAX_VIDEO_FILE_SIZE_BYTES=52428800
MEDIA_POST_IMAGE_MAX_COUNT=5
MEDIA_POST_MEDIA_MAX_COUNT=5
# Demo fallback only. Use a paid or self-hosted Piston-compatible runner for reliable code execution.
PISTON_API_URL=https://emkc.org/api/v2/piston
PISTON_RUN_TIMEOUT_MS=5000
PISTON_COMPILE_TIMEOUT_MS=10000
PROBLEM_RUN_LOCK_TTL_SECONDS=60

# Optional Gemini free-tier AI problem generation. Without a key, the generation endpoint stays unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=20000
